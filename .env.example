# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public app URL used in auth emails (required in production).
# Use your stable Vercel URL — never a preview URL like project-xxxxx.vercel.app
NEXT_PUBLIC_SITE_URL=https://eden-harvest.vercel.app

# Stripe (optional until checkout is wired up)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (optional — for Resend when transactional email is added)
RESEND_API_KEY=re_...

# Supabase admin (required for the in-app chat entitlement check — see lib/supabase/admin.ts)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stream Chat (in-app buyer-seller messaging)
NEXT_PUBLIC_STREAM_API_KEY=your-stream-api-key
STREAM_API_SECRET=your-stream-api-secret

# Admin verification dashboard (comma-separated emails)
ADMIN_EMAILS=you@example.com
